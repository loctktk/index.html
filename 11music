<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <meta name="apple-mobile-web-app-title" content="MyMusic">
  <title>MyMusic - Nghe Nhạc Không Quảng Cáo</title>
  <style>
    :root {
      --bg: #0f0f13;
      --card: #1c1c24;
      --accent: #1db954;
      --text: #ffffff;
      --subtext: #9ca3af;
      --danger: #ef4444;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; -webkit-tap-highlight-color: transparent; }
    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      background-color: var(--bg);
      color: var(--text);
      display: flex;
      flex-direction: column;
      height: 100vh;
      overflow: hidden;
    }
    header {
      padding: 20px 16px 12px;
      background: var(--card);
      display: flex;
      justify-content: space-between;
      align-items: center;
      border-bottom: 1px solid #2d2d3a;
    }
    header h1 { font-size: 1.25rem; font-weight: 700; }
    .add-btn {
      background: var(--accent);
      color: #000;
      font-weight: 600;
      padding: 8px 14px;
      border-radius: 20px;
      font-size: 0.9rem;
      cursor: pointer;
      border: none;
    }
    #file-input { display: none; }
    
    /* Danh sách bài hát */
    #playlist {
      flex: 1;
      overflow-y: auto;
      padding: 12px 16px;
      list-style: none;
    }
    .empty-state {
      text-align: center;
      color: var(--subtext);
      margin-top: 60px;
      font-size: 0.95rem;
      line-height: 1.5;
    }
    .track-item {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 12px;
      margin-bottom: 8px;
      background: var(--card);
      border-radius: 12px;
      cursor: pointer;
      transition: background 0.2s;
    }
    .track-item.active {
      border: 1px solid var(--accent);
      background: #192a20;
    }
    .track-info {
      flex: 1;
      overflow: hidden;
      padding-right: 12px;
    }
    .track-title {
      font-size: 0.95rem;
      font-weight: 500;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .track-item.active .track-title { color: var(--accent); font-weight: 600; }
    .delete-btn {
      background: transparent;
      border: none;
      color: var(--subtext);
      font-size: 1.1rem;
      padding: 4px 8px;
      cursor: pointer;
    }
    .delete-btn:hover { color: var(--danger); }

    /* Trình điều khiển phía dưới */
    .player-bar {
      background: var(--card);
      padding: 16px;
      border-top: 1px solid #2d2d3a;
      display: flex;
      flex-direction: column;
      gap: 10px;
    }
    .now-playing {
      font-size: 0.9rem;
      font-weight: 600;
      text-align: center;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      color: var(--text);
    }
    .progress-container {
      display: flex;
      align-items: center;
      gap: 8px;
      font-size: 0.75rem;
      color: var(--subtext);
    }
    #seek-bar {
      flex: 1;
      accent-color: var(--accent);
      height: 4px;
      cursor: pointer;
    }
    .controls {
      display: flex;
      justify-content: space-around;
      align-items: center;
      margin-top: 4px;
    }
    .ctrl-btn {
      background: none;
      border: none;
      color: var(--text);
      font-size: 1.3rem;
      cursor: pointer;
      padding: 8px;
    }
    .ctrl-btn.play-pause {
      background: var(--accent);
      color: #000;
      width: 50px;
      height: 50px;
      border-radius: 50%;
      font-size: 1.4rem;
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: bold;
    }
    .ctrl-btn.active-mode { color: var(--accent); }
  </style>
</head>
<body>

  <header>
    <h1>🎵 Kho Nhạc Của Tôi</h1>
    <label class="add-btn" for="file-input">+ Thêm nhạc</label>
    <input type="file" id="file-input" accept="audio/*,.mp3,.m4a,.flac,.wav" multiple>
  </header>

  <ul id="playlist">
    <div class="empty-state">Chưa có bài hát nào.<br>Nhấn <b>"+ Thêm nhạc"</b> để lưu nhạc từ điện thoại vào ứng dụng.</div>
  </ul>

  <div class="player-bar">
    <div class="now-playing" id="now-playing">Chưa chọn bài hát</div>
    <div class="progress-container">
      <span id="current-time">0:00</span>
      <input type="range" id="seek-bar" value="0" min="0" max="100" step="0.1">
      <span id="duration">0:00</span>
    </div>
    <div class="controls">
      <button class="ctrl-btn" id="shuffle-btn" title="Trộn bài">🔀</button>
      <button class="ctrl-btn" id="prev-btn" title="Bài trước">⏮</button>
      <button class="ctrl-btn play-pause" id="play-btn" title="Phát/Tạm dừng">▶</button>
      <button class="ctrl-btn" id="next-btn" title="Bài tiếp">⏭</button>
      <button class="ctrl-btn" id="loop-btn" title="Lặp lại 1 bài">🔁</button>
    </div>
  </div>

  <audio id="audio-player" playsinline></audio>

  <script>
    const dbName = 'OfflineMusicDB';
    const storeName = 'tracks';
    let db;
    let tracks = [];
    let currentIndex = -1;
    let isShuffle = false;
    let isLoopOne = false;

    const audio = document.getElementById('audio-player');
    const fileInput = document.getElementById('file-input');
    const playlistEl = document.getElementById('playlist');
    const nowPlayingEl = document.getElementById('now-playing');
    const playBtn = document.getElementById('play-btn');
    const prevBtn = document.getElementById('prev-btn');
    const nextBtn = document.getElementById('next-btn');
    const shuffleBtn = document.getElementById('shuffle-btn');
    const loopBtn = document.getElementById('loop-btn');
    const seekBar = document.getElementById('seek-bar');
    const currentTimeEl = document.getElementById('current-time');
    const durationEl = document.getElementById('duration');

    // 1. Khởi tạo bộ nhớ IndexedDB trên điện thoại
    const request = indexedDB.open(dbName, 1);
    request.onupgradeneeded = (e) => {
      db = e.target.result;
      if (!db.objectStoreNames.contains(storeName)) {
        db.createObjectStore(storeName, { keyPath: 'id', autoIncrement: true });
      }
    };
    request.onsuccess = (e) => {
      db = e.target.result;
      loadTracksFromDB();
    };

    // 2. Thêm file nhạc vào bộ nhớ máy
    fileInput.addEventListener('change', (e) => {
      const files = Array.from(e.target.files);
      if (!files.length) return;

      const tx = db.transaction(storeName, 'readwrite');
      const store = tx.objectStore(storeName);

      files.forEach(file => {
        const cleanName = file.name.replace(/\.[^/.]+$/, "");
        store.add({ name: cleanName, blob: file });
      });

      tx.oncomplete = () => {
        fileInput.value = '';
        loadTracksFromDB();
      };
    });

    // 3. Tải danh sách bài hát đã lưu
    function loadTracksFromDB() {
      const tx = db.transaction(storeName, 'readonly');
      const store = tx.objectStore(storeName);
      const req = store.getAll();

      req.onsuccess = () => {
        tracks = req.result;
        renderPlaylist();
      };
    }

    // 4. Hiển thị danh sách phát
    function renderPlaylist() {
      playlistEl.innerHTML = '';
      if (tracks.length === 0) {
        playlistEl.innerHTML = '<div class="empty-state">Chưa có bài hát nào.<br>Nhấn <b>"+ Thêm nhạc"</b> để lưu nhạc từ điện thoại vào ứng dụng.</div>';
        return;
      }

      tracks.forEach((track, idx) => {
        const li = document.createElement('li');
        li.className = 'track-item' + (idx === currentIndex ? ' active' : '');

        const info = document.createElement('div');
        info.className = 'track-info';
        info.innerHTML = `<div class="track-title">${track.name}</div>`;
        info.onclick = () => playTrack(idx);

        const delBtn = document.createElement('button');
        delBtn.className = 'delete-btn';
        delBtn.innerHTML = '✕';
        delBtn.onclick = (e) => {
          e.stopPropagation();
          deleteTrack(track.id, idx);
        };

        li.appendChild(info);
        li.appendChild(delBtn);
        playlistEl.appendChild(li);
      });
    }

    // 5. Phát bài hát & hỗ trợ khóa màn hình (Media Session API)
    function playTrack(index) {
      if (index < 0 || index >= tracks.length) return;
      currentIndex = index;
      const track = tracks[currentIndex];

      if (audio.src) URL.revokeObjectURL(audio.src);
      audio.src = URL.createObjectURL(track.blob);
      audio.play();

      nowPlayingEl.textContent = track.name;
      playBtn.textContent = '⏸';
      renderPlaylist();

      if ('mediaSession' in navigator) {
        navigator.mediaSession.metadata = new MediaMetadata({
          title: track.name,
          artist: 'Kho Nhạc Offline',
          album: 'MyMusic'
        });
        navigator.mediaSession.setActionHandler('play', () => audio.play());
        navigator.mediaSession.setActionHandler('pause', () => audio.pause());
        navigator.mediaSession.setActionHandler('previoustrack', prevTrack);
        navigator.mediaSession.setActionHandler('nexttrack', nextTrack);
      }
    }

    // 6. Xóa bài hát
    function deleteTrack(id, idx) {
      const tx = db.transaction(storeName, 'readwrite');
      tx.objectStore(storeName).delete(id);
      tx.oncomplete = () => {
        if (idx === currentIndex) {
          audio.pause();
          audio.src = '';
          nowPlayingEl.textContent = 'Chưa chọn bài hát';
          playBtn.textContent = '▶';
          currentIndex = -1;
        } else if (idx < currentIndex) {
          currentIndex--;
        }
        loadTracksFromDB();
      };
    }

    // 7. Các nút điều khiển
    playBtn.onclick = () => {
      if (!tracks.length) return;
      if (currentIndex === -1) {
        playTrack(0);
      } else if (audio.paused) {
        audio.play();
        playBtn.textContent = '⏸';
      } else {
        audio.pause();
        playBtn.textContent = '▶';
      }
    };

    function nextTrack() {
      if (!tracks.length) return;
      if (isShuffle) {
        const randomIdx = Math.floor(Math.random() * tracks.length);
        playTrack(randomIdx);
      } else {
        const nextIdx = (currentIndex + 1) % tracks.length;
        playTrack(nextIdx);
      }
    }

    function prevTrack() {
      if (!tracks.length) return;
      const prevIdx = (currentIndex - 1 + tracks.length) % tracks.length;
      playTrack(prevIdx);
    }

    nextBtn.onclick = nextTrack;
    prevBtn.onclick = prevTrack;

    shuffleBtn.onclick = () => {
      isShuffle = !isShuffle;
      shuffleBtn.classList.toggle('active-mode', isShuffle);
    };

    loopBtn.onclick = () => {
      isLoopOne = !isLoopOne;
      audio.loop = isLoopOne;
      loopBtn.classList.toggle('active-mode', isLoopOne);
    };

    audio.onended = () => {
      if (!isLoopOne) nextTrack();
    };

    audio.onplay = () => playBtn.textContent = '⏸';
    audio.onpause = () => playBtn.textContent = '▶';

    // Cập nhật thanh thời gian
    audio.ontimeupdate = () => {
      if (audio.duration) {
        seekBar.value = (audio.currentTime / audio.duration) * 100;
        currentTimeEl.textContent = formatTime(audio.currentTime);
        durationEl.textContent = formatTime(audio.duration);
      }
    };

    seekBar.oninput = () => {
      if (audio.duration) {
        audio.currentTime = (seekBar.value / 100) * audio.duration;
      }
    };

    function formatTime(sec) {
      const m = Math.floor(sec / 60);
      const s = Math.floor(sec % 60);
      return m + ':' + (s < 10 ? '0' : '') + s;
    }
  </script>
</body>
</html>
